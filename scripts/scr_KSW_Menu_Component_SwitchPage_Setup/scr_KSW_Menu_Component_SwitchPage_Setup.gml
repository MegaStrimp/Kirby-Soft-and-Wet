///@description KSW - Menu - Component - Switch Page - Setup

function scr_KSW_Menu_Component_SwitchPage_Setup(targetPageRows,targetPageColumns,targetPage = 0)
{
	#region Variables
	page = targetPage;
	pageRows = targetPageRows;
	pageColumns = targetPageColumns;
	pageSelectionCount = targetPageRows * targetPageColumns;
	pageMax = floor((selectionCount - 1) / pageSelectionCount);
	#endregion
}